# Octopus Agile Dashboard Configuration
# Copy this file to .env for local development

# Octopus Energy Region (A-P for UK regions)
# C = London
VITE_OCTOPUS_REGION=C

# Octopus Agile Product Code
# Find current products at: https://octopus.energy/
VITE_AGILE_PRODUCT=AGILE-24-10-01

# Octopus Gas Tracker Product Code
VITE_GAS_PRODUCT=SILVER-25-09-02

# Weather Location (latitude/longitude)
# Default: London (51.5074, -0.1278)
VITE_WEATHER_LAT=51.5074
VITE_WEATHER_LON=-0.1278

# Price Thresholds (in pence per kWh)
# These determine the color coding of prices:
# - Cheap (Green): < THRESHOLD_CHEAP
# - Moderate (Blue): THRESHOLD_CHEAP to THRESHOLD_MODERATE
# - Expensive (Yellow): THRESHOLD_MODERATE to THRESHOLD_EXPENSIVE
# - Very Expensive (Red): > THRESHOLD_EXPENSIVE
VITE_THRESHOLD_CHEAP=10
VITE_THRESHOLD_MODERATE=20
VITE_THRESHOLD_EXPENSIVE=35
